# Copy to .streamlit/secrets.toml (ignored by git) or enter these on the
# hosting platform. Placeholders only: never commit real values.

OPDI_EXPLORER_RELEASE = "s3://<bucket>/<path>/<release>"
OPDI_S3_ENDPOINT = "https://<your-s3-endpoint>"
AWS_ACCESS_KEY_ID = "<key id>"
AWS_SECRET_ACCESS_KEY = "<secret>"

# Optional
# OPDI_EXPLORER_FROM_DAY = "2026-07-01"
# OPDI_EXPLORER_MEMORY = "1GB"
# OPDI_TRACKS = "s3://<bucket>/<path to hourly state vectors>"
# OPDI_TRACKS_ENDPOINT = "https://<s3-endpoint of the tracks>"
# OPDI_TRACKS_KEY_ID = "<key id>"
# OPDI_TRACKS_SECRET = "<secret>"
